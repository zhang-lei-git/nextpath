<view class="page"><view class="eyebrow">高中信息</view><view class="page-title">{{name}}</view><view class="empty card" wx:if="{{!loading && !facts.length}}">学校信息正在持续补充</view><view class="fact card" wx:for="{{facts}}" wx:key="id"><view class="fact-title">{{item.field}}</view><view class="fact-value">{{item.value.summary || item.value.level || item.value.district || '已收录'}}</view><view class="muted">{{item.reference_year}} 年 · {{item.confidence}}</view></view></view>
