<view class="page">
  <view class="eyebrow">孩子信息</view><view class="page-title">先认识一下孩子</view>
  <view class="intro">填写这三项后，就能持续看到孩子在升学中的位置。目标高中以后想好了再补充。</view>
  <view class="form card">
    <view class="field"><view class="label">孩子称呼</view><input placeholder="例如：小远" value="{{form.student_name}}" data-key="student_name" bindinput="input" /></view>
    <view class="field">
      <view class="label">所在初中</view>
      <input placeholder="输入学校名称后选择" value="{{form.junior_school}}" data-key="junior_school" bindinput="input" />
      <view class="school-matches" wx:if="{{juniorMatches.length}}">
        <view class="school-match" wx:for="{{juniorMatches}}" wx:key="id" data-name="{{item.entity_name}}" data-key="junior_school" bindtap="selectSchool">
          <view>{{item.entity_name}}</view><text>{{item.value.district || '西安'}}</text>
        </view>
      </view>
    </view>
    <view class="field"><view class="label">当前年级</view><picker range="{{grades}}" value="{{gradeIndex}}" bindchange="gradeChange"><view class="picker-value">{{form.grade}}</view></picker></view>
    <view class="field"><view class="label">所在班型 <text>选填</text></view><picker range="{{classTypes}}" value="{{classTypeIndex}}" bindchange="classTypeChange"><view class="picker-value">{{form.class_type_standard === '未知' ? '暂不填写' : form.class_type_standard}}</view></picker></view>
    <view class="field last">
      <view class="label">目标高中 <text>选填</text></view>
      <input placeholder="输入学校名称后选择" value="{{form.target_school}}" data-key="target_school" bindinput="input" />
      <view class="school-matches" wx:if="{{targetMatches.length}}">
        <view class="school-match" wx:for="{{targetMatches}}" wx:key="id" data-name="{{item.entity_name}}" data-key="target_school" bindtap="selectSchool">
          <view>{{item.entity_name}}</view><text>{{item.value.level || item.value.district || '西安'}}</text>
        </view>
      </view>
    </view>
  </view>
  <button class="primary-button save" bindtap="save" loading="{{saving}}">保存并开始记录</button>
</view>
