.page-title { margin: 12rpx 0; color: #143F43; font-size: 44rpx; font-weight: 700; }.intro { color:#687574; font-size:27rpx; line-height:1.7; }.form { margin-top:38rpx; padding:0 28rpx; }.field { padding:27rpx 0 20rpx; border-bottom:1rpx solid #E2E8E5; }.field.last { border:0; }.label { margin-bottom:10rpx; color:#143F43; font-size:28rpx; font-weight:600; }.label text { color:#687574; font-size:22rpx; font-weight:400; } input,.picker-value { height:52rpx; font-size:30rpx; line-height:52rpx; }.school-matches { margin-top:12rpx; border:1rpx solid #D7E4E1; border-radius:8rpx; overflow:hidden; }.school-match { display:flex; justify-content:space-between; gap:20rpx; padding:17rpx 16rpx; border-bottom:1rpx solid #E6EEEC; color:#143F43; font-size:27rpx; }.school-match:last-child { border-bottom:0; }.school-match text { color:#6B7A78; font-size:23rpx; }.save { width:100%; margin-top:32rpx; }
