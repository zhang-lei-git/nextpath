.report-title { margin: 12rpx 0 8rpx; color: #143F43; font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.report-copy { margin-bottom: 30rpx; color: #687574; font-size: 26rpx; line-height: 1.65; }
.hero { padding: 30rpx; border: 0; background: #143F43; }
.hero-label, .hero-school { color: #B9D9D2; font-size: 23rpx; }
.hero-target { margin: 8rpx 0 10rpx; color: #FFFFFF; font-size: 38rpx; font-weight: 700; line-height: 1.35; }
.hero-verdict { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,.22); color: #FFFFFF; font-size: 27rpx; font-weight: 600; line-height: 1.55; }
.kpi-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.kpi { min-height: 180rpx; padding: 24rpx; }.kpi.teal { background: #EFF6F4; border-color: #CFE0DB; }.kpi.blue { background: #EFF5FA; border-color: #D1E0ED; }.kpi.green { background: #F1F7F0; border-color: #D4E3CF; }
.kpi-label { color: #687574; font-size: 22rpx; }.kpi-value { margin: 12rpx 0 6rpx; color: #143F43; font-family: ui-monospace, Menlo, monospace; font-size: 31rpx; font-weight: 700; line-height: 1.3; }.kpi-note { color: #687574; font-size: 21rpx; line-height: 1.35; }
.subjects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: hidden; }.subject { display: flex; align-items: baseline; justify-content: space-between; padding: 22rpx; border-right: 1rpx solid #E2E8E5; border-bottom: 1rpx solid #E2E8E5; }.subject:nth-child(2n) { border-right: 0; }.subject-name { color: #334542; font-size: 26rpx; }.subject-score { color: #143F43; font-family: ui-monospace, Menlo, monospace; font-size: 29rpx; font-weight: 700; }.subject-score text { margin-left: 3rpx; color: #687574; font-size: 20rpx; font-weight: 500; }
.history { padding: 4rpx 26rpx; }.history-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #E2E8E5; }.history-row:last-child { border-bottom: 0; }.history-row.current .history-label { color: #16766D; }.history-label { color: #143F43; font-size: 27rpx; font-weight: 600; }.history-rank { margin-top: 6rpx; color: #687574; font-size: 22rpx; }.history-total { color: #143F43; font-family: ui-monospace, Menlo, monospace; font-size: 35rpx; font-weight: 700; }.history-total text { margin-left: 3rpx; color: #687574; font-family: inherit; font-size: 20rpx; font-weight: 500; }
.observations, .steps { padding: 6rpx 28rpx; }.observation, .step { display: flex; gap: 18rpx; padding: 23rpx 0; border-bottom: 1rpx solid #E2E8E5; color: #334542; font-size: 26rpx; line-height: 1.6; }.observation:last-child, .step:last-child { border-bottom: 0; }.dot { width: 12rpx; height: 12rpx; flex: none; margin-top: 15rpx; border-radius: 50%; background: #16766D; }.step-time { width: 108rpx; flex: none; color: #16766D; font-size: 23rpx; font-weight: 700; }.step-title { color: #143F43; font-size: 27rpx; font-weight: 600; }.step-copy { margin-top: 5rpx; color: #687574; font-size: 24rpx; line-height: 1.55; }
.loading, .error-title { margin-top: 180rpx; color: #143F43; font-size: 38rpx; font-weight: 700; text-align: center; }.error-copy { margin: 18rpx 0 44rpx; color: #687574; font-size: 27rpx; text-align: center; }.error-page .primary-button { width: 100%; }
.outcomes { padding:8rpx 26rpx; }.outcome { padding:22rpx 0; border-bottom:1rpx solid #E2E8E5; color:#334542; font-size:24rpx; line-height:1.65; }.outcome:last-child { border-bottom:0; }.outcome.steady { color:#143F43; font-weight:600; }.outcome-title { color:#16766D; font-size:28rpx; }.outcome-scope { color:#143F43; font-size:26rpx; font-weight:600; }.source-note { margin:24rpx 4rpx; color:#687574; font-size:22rpx; line-height:1.6; }
