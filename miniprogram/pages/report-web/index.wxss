.report-title { margin: 12rpx 0 10rpx; color: #1E293B; font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.report-copy { margin-bottom: 28rpx; color: #64748B; font-size: 26rpx; line-height: 1.7; }
.hero { padding: 34rpx 32rpx; border: 0; background: linear-gradient(135deg,#059669,#0EA5E9); }
.hero-label, .hero-school { color: rgba(255,255,255,.78); font-size: 23rpx; line-height: 1.55; }
.hero-target { margin: 10rpx 0 12rpx; color: #FFFFFF; font-size: 40rpx; font-weight: 750; line-height: 1.35; }
.hero-verdict { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,.22); color: #FFFFFF; font-size: 27rpx; font-weight: 600; line-height: 1.65; }
.kpi-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 24rpx; }
.kpi { min-height: 176rpx; padding: 24rpx; }
.kpi.teal, .kpi.green { background: #ECFDF5; border-color: #A7F3D0; }
.kpi.blue { background: #F0F9FF; border-color: #BAE6FD; }
.kpi.amber { background: #FFFBEB; border-color: #FDE68A; }
.kpi-label { color: #64748B; font-size: 22rpx; }
.kpi-value { margin: 12rpx 0 6rpx; color: #1E293B; font-family: ui-monospace, Menlo, monospace; font-size: 31rpx; font-weight: 700; line-height: 1.3; }
.kpi-note { color: #64748B; font-size: 21rpx; line-height: 1.4; }
.decision-card { padding: 30rpx 32rpx; color: #475569; font-size: 28rpx; line-height: 1.75; }
.decision-grid { display: grid; gap: 16rpx; }
.decision-item { position: relative; padding: 28rpx 28rpx 26rpx 82rpx; }
.decision-index { position:absolute; left:28rpx; top:28rpx; width:36rpx; height:36rpx; border-radius:50%; background:#059669; color:#fff; font-size:22rpx; font-weight:700; line-height:36rpx; text-align:center; }
.decision-title { color:#1E293B; font-size:29rpx; font-weight:700; }
.decision-copy { margin-top:8rpx; color:#475569; font-size:25rpx; line-height:1.65; }
.outcome-list { display:grid; gap:18rpx; }
.outcome { padding:30rpx 32rpx; }
.outcome.steady { background:#ECFDF5; border-color:#A7F3D0; }
.outcome-head { display:flex; justify-content:space-between; gap:20rpx; align-items:flex-start; margin-bottom:14rpx; }
.outcome-head text { color:#64748B; font-size:25rpx; font-weight:600; }
.outcome-head view { color:#1E293B; font-size:29rpx; font-weight:700; text-align:right; line-height:1.35; }
.outcome-score { color:#1E293B; font-family:ui-monospace, Menlo, monospace; font-size:40rpx; font-weight:700; line-height:1.35; }
.outcome-rank { margin-top:8rpx; color:#64748B; font-size:25rpx; }
.outcome-target { margin-top:16rpx; padding-top:16rpx; border-top:1rpx solid #E2E8F0; color:#D97706; font-size:25rpx; font-weight:600; line-height:1.55; }
.subject-list { display:grid; gap:16rpx; }
.subject { padding:26rpx 28rpx; }
.subject.high, .subject.green { border-color:#A7F3D0; background:#ECFDF5; }
.subject.risk { border-color:#FDE68A; background:#FFFBEB; }
.subject-head { display:flex; justify-content:space-between; gap:20rpx; align-items:baseline; }
.subject-name { color:#1E293B; font-size:29rpx; font-weight:700; }
.subject-score { color:#1E293B; font-family:ui-monospace, Menlo, monospace; font-size:32rpx; font-weight:700; }
.subject-score text { margin-left:3rpx; color:#64748B; font-size:20rpx; font-weight:500; }
.subject-role { margin-top:10rpx; color:#059669; font-size:24rpx; font-weight:700; }
.subject-action { margin-top:8rpx; color:#475569; font-size:25rpx; line-height:1.6; }
.school-card, .path-card, .check-card, .evidence { padding: 28rpx 30rpx; }
.school-title, .check-title { color:#1E293B; font-size:29rpx; font-weight:700; }
.school-copy { margin-top:10rpx; color:#475569; font-size:26rpx; line-height:1.7; }
.tier-card { margin-top:18rpx; padding:20rpx; background:#F8FAFC; border-radius:12rpx; }
.tier-head { display:flex; justify-content:space-between; gap:20rpx; color:#1E293B; font-size:25rpx; font-weight:700; }
.tier-head text { color:#059669; }
.tier-detail { margin-top:8rpx; color:#64748B; font-size:24rpx; line-height:1.6; }
.school-takeaway { margin-top:18rpx; padding-top:18rpx; border-top:1rpx solid #E2E8F0; color:#D97706; font-size:25rpx; font-weight:600; line-height:1.6; }
.milestone { display:flex; gap:18rpx; padding:18rpx 0; border-bottom:1rpx solid #E2E8F0; }
.milestone-time { flex:none; width:124rpx; color:#059669; font-size:23rpx; font-weight:700; }
.milestone-goal { flex:1; color:#475569; font-size:25rpx; line-height:1.6; }
.scenario-row { margin-top:18rpx; padding:20rpx; background:#F8FAFC; border-radius:12rpx; }
.scenario-title { color:#1E293B; font-size:26rpx; font-weight:700; }
.scenario-text { margin-top:8rpx; color:#64748B; font-size:24rpx; line-height:1.6; }
.history { padding: 4rpx 26rpx; }
.history-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #E2E8F0; }
.history-row:last-child { border-bottom: 0; }
.history-row.current .history-label { color: #059669; }
.history-label { color: #1E293B; font-size: 27rpx; font-weight: 600; }
.history-rank { margin-top: 6rpx; color: #64748B; font-size: 22rpx; }
.history-total { color: #1E293B; font-family: ui-monospace, Menlo, monospace; font-size: 35rpx; font-weight: 700; }
.history-total text { margin-left: 3rpx; color: #64748B; font-family: inherit; font-size: 20rpx; font-weight: 500; }
.steps { padding: 6rpx 28rpx; }
.step { display: flex; gap: 18rpx; padding: 23rpx 0; border-bottom: 1rpx solid #E2E8F0; color: #475569; font-size: 26rpx; line-height: 1.6; }
.step:last-child { border-bottom: 0; }
.step-time { width: 116rpx; flex: none; color: #059669; font-size: 23rpx; font-weight: 700; }
.step-title { color: #1E293B; font-size: 27rpx; font-weight: 600; }
.step-copy { margin-top: 5rpx; color: #64748B; font-size: 24rpx; line-height: 1.55; }
.check-card { margin-top: 16rpx; }
.check-item { margin-top:14rpx; color:#475569; font-size:25rpx; line-height:1.6; }
.check-item::before { content:'✓'; margin-right:10rpx; color:#059669; font-weight:700; }
.check-note { margin-top:16rpx; color:#94A3B8; font-size:23rpx; line-height:1.6; }
.evidence-row { display:flex; gap:18rpx; padding:20rpx 0; border-bottom:1rpx solid #E2E8F0; }
.evidence-row:last-child { border-bottom:0; }
.evidence-metric { flex:none; width:104rpx; color:#059669; font-size:23rpx; font-weight:700; }
.evidence-title { color:#1E293B; font-size:26rpx; font-weight:650; }
.evidence-detail { margin-top:6rpx; color:#64748B; font-size:23rpx; line-height:1.55; }
.source-note { margin-top:16rpx; padding:24rpx 28rpx; color:#64748B; font-size:23rpx; line-height:1.7; }
.loading, .error-title { margin-top: 180rpx; color: #1E293B; font-size: 38rpx; font-weight: 700; text-align: center; }
.error-copy { margin: 18rpx 0 44rpx; color: #64748B; font-size: 27rpx; text-align: center; }
.error-page .primary-button { width: 100%; }
