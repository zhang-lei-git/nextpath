.intro { margin-bottom: 28rpx; }
.summary {
  margin-bottom: 36rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-color: #D1FAE5;
}
.summary-label { color:#059669; font-size:23rpx; font-weight:700; }
.summary-title { margin: 10rpx 0 22rpx; color: #1E293B; font-size: 32rpx; font-weight: 700; line-height:1.5; }
.summary-item { padding: 20rpx 0 0; border-top: 1rpx solid #E2E8F0; color: #475569; font-size: 26rpx; line-height: 1.6; }
.summary-item + .summary-item { margin-top: 16rpx; }
.summary-item text { display: block; margin-bottom: 4rpx; color: #94A3B8; font-size: 22rpx; }

.section-block { margin-top: 36rpx; }
.section-block .section-title { margin-top: 0; }
.scenario {
  margin-bottom: 20rpx;
  padding: 30rpx 32rpx;
}
.scenario.projection {
  background: #FFFFFF;
  border-color: #E2E8F0;
}
.scenario.projection.steady {
  border-color: #059669;
  background: #ECFDF5;
}
.scenario-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}
.scenario-label { color:#64748B; font-size:26rpx; font-weight:600; }
.scenario-scope { color:#1E293B; font-size:30rpx; font-weight:700; line-height:1.4; text-align:right; }
.scenario-tag {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 6rpx 18rpx;
  background: #ECFDF5;
  color: #059669;
  font-size: 24rpx;
  font-weight: 650;
  border-radius: 8rpx;
}
.scenario-score { color:#1E293B; font-family:ui-monospace, Menlo, monospace; font-size:44rpx; font-weight:700; line-height:1.35; }
.scenario-score text { color:#64748B; font-family:-apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size:26rpx; font-weight:500; }
.scenario-meta { margin-top:12rpx; color:#64748B; font-size:26rpx; line-height:1.55; }
.scenario-gap { margin-top:16rpx; padding-top:16rpx; border-top:1rpx solid #E2E8F0; color:#D97706; font-size:26rpx; font-weight:600; line-height:1.55; }
.school-tiers { margin-top:24rpx; padding:18rpx 20rpx; background:#F8FAFC; border-radius:12rpx; }
.tier-row { display:flex; gap:16rpx; padding:8rpx 0; color:#475569; font-size:25rpx; line-height:1.5; }
.tier-name { width:56rpx; flex:none; color:#059669; font-weight:700; }
.tier-values { display:flex; flex-wrap:wrap; gap:6rpx 18rpx; }
.school-name { color:#475569; }
.analysis-actions { margin-top: 44rpx; }
.report-history { margin-top: 16rpx; }
