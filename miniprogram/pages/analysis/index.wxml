<view class="page" wx:if="{{forecast}}">
  <view class="eyebrow">判断依据</view>
  <view class="page-title">目标与两种判断</view>
  <view class="summary card">
    <view class="summary-label">目标</view>
    <view class="tier" wx:if="{{report}}">{{report.target_summary}}</view>
    <view class="summary-line" wx:if="{{forecast.target_percentile !== null}}">目标高中历史入口位置：全区前 {{forecast.target_percentile}}%</view>
  </view>
  <view class="section-title">当前现状</view>
  <view class="scenario card" wx:if="{{forecast.current_snapshot}}">
    <view class="scenario-score">{{forecast.current_snapshot.total_range[0]}} / {{forecast.current_snapshot.total_full_mark}} 分</view>
    <view class="scenario-meta" wx:if="{{forecast.current_snapshot.current_percentile !== null}}">全区前 {{forecast.current_snapshot.estimated_percentile_range[0]}}%–{{forecast.current_snapshot.estimated_percentile_range[1]}}%</view>
    <view class="scenario-meta" wx:else>等待可用历史参考数据</view>
    <view class="scenario-gap" wx:if="{{forecast.current_snapshot.target_percentile_gap !== null}}">距目标：还需前移 {{forecast.current_snapshot.target_percentile_gap}} 个百分点</view>
    <view class="muted">{{forecast.current_snapshot.summary}}</view>
  </view>
  <view class="section-title">合理预测</view>
  <view class="scenario card projection" wx:if="{{forecast.reasonable_projection}}">
    <view class="scenario-score">{{forecast.reasonable_projection.total_range[0]}}–{{forecast.reasonable_projection.total_range[1]}} / {{forecast.reasonable_projection.total_full_mark}} 分</view>
    <view class="scenario-meta" wx:if="{{forecast.reasonable_projection.current_percentile !== null}}">全区前 {{forecast.reasonable_projection.estimated_percentile_range[0]}}%–{{forecast.reasonable_projection.estimated_percentile_range[1]}}%</view>
    <view class="scenario-meta" wx:else>等待可用历史参考数据</view>
    <view class="scenario-gap" wx:if="{{forecast.reasonable_projection.target_percentile_gap !== null}}">距目标：还需前移 {{forecast.reasonable_projection.target_percentile_gap}} 个百分点</view>
    <view class="muted">{{forecast.reasonable_projection.summary}}</view>
  </view>
  <view class="section-title">本期升学位置报告</view>
  <view class="report card" wx:if="{{report}}">
    <view class="report-headline">{{report.headline}}</view>
    <view class="report-block"><view class="report-label">全区位置</view><view>{{report.current_position}}</view></view>
    <view class="report-block"><view class="report-label">成绩趋势</view><view>{{report.trend_summary}}</view></view>
    <view class="report-block"><view class="report-label">目标高中</view><view>{{report.target_summary}}</view></view>
    <view class="report-block"><view class="report-label">所在初中</view><view>{{report.school_context}}</view></view>
    <view class="report-block last"><view class="report-label">政策提示</view><view>{{report.policy_summary}}</view></view>
  </view>
  <view class="section-title">这项判断基于什么</view>
  <view class="basis card"><view class="basis-item" wx:for="{{forecast.basis}}" wx:key="*this">{{item}}</view></view>
  <view class="section-title">结论的边界</view>
  <view class="boundary card">
    <view>可信度：{{forecast.confidence === 'low' ? '初步判断' : forecast.confidence}}</view>
    <view class="muted">当前缺少完整的本校历史位次与官方一分一段数据。本次先给出参考区间，成绩和公开数据补齐后会持续更新。</view>
  </view>
  <view class="model">本次判断参考 {{forecast.reference_year}} 年公开数据，录取结果以当年官方发布为准。</view>
  <button class="primary-button" bindtap="goToEntry">更新成绩后重新判断</button>
  <button class="secondary-button report-history" bindtap="goToReports">查看历次报告</button>
</view>
