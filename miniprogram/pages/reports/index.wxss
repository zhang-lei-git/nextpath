.page-title { margin: 12rpx 0 30rpx; color: #143F43; font-size: 44rpx; font-weight: 700; }
.report-card { display:flex; width:100%; align-items:center; justify-content:space-between; margin-bottom:16rpx; padding:27rpx; text-align:left; }
