.report-card {
  display: block;
  width: calc(100vw - 64rpx);
  min-width: calc(100vw - 64rpx);
  box-sizing: border-box;
  margin: 0 0 22rpx;
  padding: 30rpx 32rpx;
  text-align: left;
}
.report-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:16rpx; }
.report-kind { color:#059669; font-size:23rpx; font-weight:700; }
.report-date { color:#94A3B8; font-size:23rpx; }
.report-title { color:#1E293B; font-size:32rpx; font-weight:700; line-height:1.45; }
.report-verdict { margin-top:14rpx; color:#475569; font-size:27rpx; line-height:1.55; }
.report-meta-row { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:14rpx; margin-top:20rpx; }
.report-meta-row view { padding:18rpx; background:#F8FAFC; border-radius:12rpx; color:#1E293B; font-size:24rpx; line-height:1.5; }
.report-meta-row text { display:block; margin-bottom:4rpx; color:#94A3B8; font-size:21rpx; }
.report-action { display:flex; justify-content:space-between; align-items:center; margin-top:22rpx; padding-top:18rpx; border-top:1rpx solid #E2E8F0; color:#0EA5E9; font-size:25rpx; font-weight:600; }
.empty { padding:34rpx 28rpx; color:#94A3B8; font-size:27rpx; text-align:center; }
