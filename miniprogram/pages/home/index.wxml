<block wx:if="{{loading && !firstScreen}}">
  <view class="page"><view class="loading">正在整理孩子的升学信息</view></view>
</block>
<block wx:elif="{{loadError}}">
  <view class="page">
    <view class="error-title">暂时没有连接上</view>
    <view class="error-copy">请检查网络后重新试一次。</view>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>
</block>
<block wx:else>
<view class="page" wx:if="{{dashboard}}">

  <view class="header">
    <view class="eyebrow">NEXT PATH · 升学助手</view>
    <view class="greeting">{{dashboard.profile_complete ? dashboard.student_name + '的升学位置' : '先建立孩子档案'}}</view>
  </view>

  <view class="home-decisions" wx:if="{{home && dashboard.latest_exam}}">
    <view class="decision-card current-card card">
      <view class="decision-kicker">现在能看什么</view>
      <view class="decision-label">按最近一次成绩</view>
      <view class="decision-answer">{{firstScreen.school_scope}}</view>
      <view class="decision-rank" wx:if="{{firstScreen.rank_text && firstScreen.rank_text !== '学校范围仍需继续观察'}}">{{firstScreen.rank_text}}</view>
      <view class="decision-score">{{dashboard.latest_exam.total_score}} / {{dashboard.latest_exam.total_full_mark || firstScreen.full_mark}} 分 · 得分率 {{firstScreen.score_rate}}</view>
      <view class="decision-grade">{{home.positionLabel}}</view>
      <view class="school-heading" wx:if="{{home.currentSchoolGroups.length}}">对应的高中范围</view>
      <view class="school-groups" wx:if="{{home.currentSchoolGroups.length}}">
        <view class="school-group" wx:for="{{home.currentSchoolGroups}}" wx:key="key">
          <text class="group-label">{{item.label}}</text>
          <view class="school-chips"><text class="school-chip" wx:for="{{item.schools}}" wx:for-item="school" wx:key="*this" data-name="{{school}}" bindtap="openSchool">{{school}} ›</text></view>
        </view>
      </view>
      <view class="uncertain" wx:if="{{!home.currentSchoolGroups.length}}">按近年录取位置，这属于“{{firstScreen.school_scope}}”这一参考层次；目前没有足够数据对应到具体学校。</view>
      <view class="school-basis-note" wx:if="{{home.currentSchoolGroups.length}}">学校层次是升学参考分类，并非教育部门正式评级；具体招生信息以学校和教育部门发布为准。</view>
    </view>

    <view class="decision-card projection-card card" wx:if="{{home.projection}}">
      <view class="decision-kicker">中考大概能到哪里</view>
      <view class="decision-label">按目前趋势估计中考</view>
      <view class="decision-answer">{{home.projection.school_scope}}</view>
      <view class="decision-rank">{{home.projectionRank}}</view>
      <view class="decision-score" wx:if="{{home.projectionRange}}">{{home.projectionRange}} / {{home.projection.total_full_mark}} 分</view>
      <view class="school-heading" wx:if="{{home.projectionSchoolGroups.length}}">对应的高中范围</view>
      <view class="school-groups" wx:if="{{home.projectionSchoolGroups.length}}">
        <view class="school-group" wx:for="{{home.projectionSchoolGroups}}" wx:key="key">
          <text class="group-label">{{item.label}}</text>
          <view class="school-chips"><text class="school-chip" wx:for="{{item.schools}}" wx:for-item="school" wx:key="*this" data-name="{{school}}" bindtap="openSchool">{{school}} ›</text></view>
        </view>
      </view>
      <view class="uncertain" wx:if="{{!home.projectionSchoolGroups.length}}">按目前预估，对应“{{home.projection.school_scope}}”这一参考层次；目前没有足够数据对应到具体学校。</view>
      <view class="school-basis-note" wx:if="{{home.projectionSchoolGroups.length}}">学校层次是升学参考分类，并非教育部门正式评级；具体招生信息以学校和教育部门发布为准。</view>
    </view>

    <view class="target-block target-card" wx:if="{{home.hasTarget}}">
      <view class="target-kicker">目标高中</view>
      <view class="target-name">{{dashboard.target_school}}</view>
      <view class="target-relation">按最近成绩：{{home.targetCurrent || '暂缺对比数据'}}</view>
      <view class="target-gap">按目前趋势：{{home.targetRelation || '暂缺对比数据'}}</view>
      <button class="target-button" bindtap="goToAnalysis">查看目标分析</button>
    </view>
    <view class="target-block target-card target-empty" wx:else>
      <view class="target-kicker">目标高中</view>
      <view class="target-name">还没有设置目标</view>
      <view class="target-gap">设置目标后，可以看到和目标的具体差距。</view>
      <button class="target-button" bindtap="showProfile">设置目标高中</button>
    </view>
    <button class="analysis-button" bindtap="goToAnalysis">查看完整分析</button>
  </view>

  <view class="empty card empty-action" wx:if="{{!dashboard.latest_exam && dashboard.profile_complete}}" bindtap="goToEntry">
    <view class="empty-title">先记录第一次成绩</view>
    <view class="empty-copy">录入最近一次周考、月考或模考成绩，就能看到孩子当前的升学范围。</view>
    <view class="empty-link">立即录入成绩 ›</view>
  </view>
  <view class="empty card empty-action" wx:if="{{!dashboard.profile_complete}}" bindtap="showProfile">
    <view class="empty-title">只需姓名、初中和年级</view>
    <view class="empty-copy">填写后即可开始记录成绩；目标高中可以以后再设置。</view>
    <view class="empty-link">建立孩子档案 ›</view>
  </view>

</view>

<view class="nav">
  <view class="nav-item active"><view>首页</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="goToScores"><view>成绩</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="showProfile"><view>我的</view><view class="nav-marker"></view></view>
</view>
</block>
