<block wx:if="{{loading}}"><view class="page"><view class="loading">正在整理孩子的升学信息</view></view></block>
<block wx:elif="{{loadError}}"><view class="page">
  <view class="error-title">暂时没有连接上</view><view class="error-copy">请检查网络后重新试一次。</view><button class="primary-button" bindtap="retry">重新加载</button>
</view></block>
<block wx:else><view class="page" wx:if="{{dashboard}}">
  <view class="topline">
    <view><view class="eyebrow">NEXT PATH · 升学助手</view><view class="greeting">{{dashboard.profile_complete ? dashboard.student_name + '的升学范围' : '先建立孩子档案'}}</view></view>
    <button class="profile" bindtap="showProfile" aria-label="查看档案">我的</button>
  </view>

  <view class="forecast card" wx:if="{{dashboard.forecast && home}}">
    <view class="forecast-label">升学范围</view>
    <button class="target-row" wx:if="{{home.hasTarget}}" bindtap="showProfile">
      <view><view class="target-label">目标高中</view><view class="target-name">{{dashboard.target_school}}</view></view><view class="row-arrow">›</view>
    </button>

    <view class="scenario current">
      <view class="scenario-label">{{home.current.title}}</view>
      <view class="scope-title">{{home.current.scope}}</view>
      <view class="scenario-score">{{home.current.score}}<text>/ {{home.current.fullMark}} 分</text></view>
      <view class="scenario-rank">{{home.current.rankText}}</view>
      <view class="school-list" wx:if="{{home.current.hasSchoolTiers}}">
        <view class="school-row" wx:for="{{home.current.schoolTiers}}" wx:key="label"><text>{{item.label}}</text><view>{{item.names}}</view></view>
      </view>
    </view>

    <view class="scenario projection">
      <view class="scenario-label">{{home.projection.title}}</view>
      <view class="scope-title">{{home.projection.scope}}</view>
      <view class="scenario-score">{{home.projection.score}}<text>/ {{home.projection.fullMark}} 分</text></view>
      <view class="scenario-rank">{{home.projection.rankText}}</view>
      <view class="school-list" wx:if="{{home.projection.hasSchoolTiers}}">
        <view class="school-row" wx:for="{{home.projection.schoolTiers}}" wx:key="label"><text>{{item.label}}</text><view>{{item.names}}</view></view>
      </view>
    </view>

    <view class="target-gap" wx:if="{{home.hasTarget}}">
      <view class="target-gap-title">距离 {{dashboard.target_school}}</view>
      <view wx:if="{{home.targetCurrent}}">当前：{{home.targetCurrent}}</view>
      <view wx:if="{{home.targetProjection}}">中考预估：{{home.targetProjection}}</view>
      <view wx:if="{{!home.targetCurrent && !home.targetProjection}}">正在结合最新成绩更新目标差距</view>
    </view>
    <button class="target-setup" wx:else bindtap="showProfile">想看看某所高中还差多少？<text>设置目标高中 ›</text></button>
    <button class="basis-link" bindtap="goToAnalysis">查看完整分析</button>
  </view>

  <view class="first-visit card" wx:else>
    <view class="first-title">{{dashboard.profile_complete ? '先记录第一次成绩' : '只需姓名、初中和年级'}}</view>
    <view class="muted">{{dashboard.profile_complete ? '录入最近一次周考、月考或模考成绩，就能看到孩子当前的升学范围。' : '填写后即可开始记录成绩；目标高中可以以后再设置。'}}</view>
  </view>

  <button class="primary-button" bindtap="goToEntry">{{dashboard.latest_exam ? '录入最新成绩' : '录入第一次成绩'}}</button>

  <view class="section-title" wx:if="{{dashboard.latest_exam}}">最近成绩</view>
  <view class="latest card" wx:if="{{dashboard.latest_exam}}" bindtap="goToScores">
    <view><view class="latest-name">{{dashboard.latest_exam.name}}</view><view class="muted">{{dashboard.latest_exam.exam_date}} · 年级第 {{dashboard.latest_exam.grade_rank || '—'}} / {{dashboard.latest_exam.grade_size || '—'}} 名</view></view>
    <view class="latest-side"><view class="score-row"><text>{{dashboard.latest_exam.total_score}}</text><text>分</text></view><view class="row-link">全部成绩 ›</view></view>
  </view>

  <view class="section-title" wx:if="{{home && home.actions.length}}">建议关注</view>
  <view class="action-list card" wx:if="{{home && home.actions.length}}">
    <view class="action" wx:for="{{home.actions}}" wx:key="title" bindtap="completeLatestExam">
      <view class="action-dot {{item.priority}}"></view><view><view class="action-title">{{item.title}}</view><view class="muted">{{item.detail}}</view></view><view class="row-arrow">›</view>
    </view>
  </view>

  <view class="section-title" wx:if="{{home && home.trend.length > 1}}">成绩变化</view>
  <view class="trend card" wx:if="{{home && home.trend.length > 1}}" bindtap="goToScores">
    <view class="trend-item" wx:for="{{home.trend}}" wx:key="id"><view class="muted">{{item.name}}</view><view class="trend-score">{{item.total_score}}</view></view>
    <view class="trend-link">查看全部 ›</view>
  </view>

  <button class="report-link" wx:if="{{dashboard.latest_exam}}" bindtap="goToReports">查看历次报告 ›</button>
</view>

<view class="nav">
  <view class="nav-item active"><view>首页</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="goToScores"><view>成绩</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="showProfile"><view>我的</view><view class="nav-marker"></view></view>
</view>
</block>
