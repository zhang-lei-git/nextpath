<block wx:if="{{loading && !firstScreen}}">
  <view class="page"><view class="loading">正在整理孩子的升学信息</view></view>
</block>
<block wx:elif="{{loadError}}">
  <view class="page">
    <view class="error-title">暂时没有连接上</view>
    <view class="error-copy">请检查网络后重新试一次。</view>
    <button class="primary-button" bindtap="retry">重新加载</button>
  </view>
</block>
<block wx:else>
<view class="page" wx:if="{{dashboard}}">

  <view class="header">
    <view class="eyebrow">NEXT PATH · 升学助手</view>
    <view class="greeting">{{dashboard.profile_complete ? dashboard.student_name + '的升学位置' : '先建立孩子档案'}}</view>
  </view>

  <view class="decision-card card" wx:if="{{home && dashboard.latest_exam}}">
    <view class="decision-block current">
      <view class="decision-kicker">按最近一次成绩</view>
      <view class="decision-answer">{{firstScreen.school_scope}}</view>
      <view class="decision-rank" wx:if="{{firstScreen.rank_text && firstScreen.rank_text !== '学校范围仍需继续观察'}}">{{firstScreen.rank_text}}</view>
      <view class="decision-score">{{dashboard.latest_exam.total_score}} / {{dashboard.latest_exam.total_full_mark || firstScreen.full_mark}} 分 · 得分率 {{firstScreen.score_rate}}</view>
      <view class="decision-grade">{{firstScreen.grade_text}}</view>
      <view class="school-heading" wx:if="{{home.currentSchools.length}}">可以重点了解</view>
      <view class="school-chips" wx:if="{{home.currentSchools.length}}">
        <text class="school-chip" wx:for="{{home.currentSchools}}" wx:key="*this" data-name="{{item}}" bindtap="openSchool">{{item}} ›</text>
      </view>
      <view class="uncertain" wx:if="{{!home.currentSchools.length}}">学校范围还不够清晰，继续记录成绩后会补充可参考的高中。</view>
    </view>

    <view class="decision-divider"></view>

    <view class="decision-block projection" wx:if="{{home.projection}}">
      <view class="decision-kicker">按目前趋势估计中考</view>
      <view class="decision-answer">{{home.projection.school_scope}}</view>
      <view class="decision-rank">{{home.projectionRank}}</view>
      <view class="decision-score" wx:if="{{home.projectionRange}}">{{home.projectionRange}} / {{home.projection.total_full_mark}} 分</view>
      <view class="school-heading" wx:if="{{home.projectionSchools.length}}">可重点了解</view>
      <view class="school-chips" wx:if="{{home.projectionSchools.length}}">
        <text class="school-chip" wx:for="{{home.projectionSchools}}" wx:key="*this" data-name="{{item}}" bindtap="openSchool">{{item}} ›</text>
      </view>
      <view class="uncertain" wx:if="{{!home.projectionSchools.length}}">目前暂时只能估到学校层次。</view>
    </view>

    <view class="target-line" wx:if="{{home.hasTarget}}" bindtap="goToAnalysis">
      <text>目标：{{dashboard.target_school}}</text>
      <text>{{home.targetRelation || '查看目标差距'}} ›</text>
    </view>
    <view class="target-line target-empty" wx:else bindtap="showProfile">
      <text>还没有设置目标高中</text><text>设置目标，查看差距 ›</text>
    </view>
    <view class="analysis-link" bindtap="goToAnalysis">查看三种中考情景和完整分析 ›</view>
  </view>

  <view class="empty card empty-action" wx:if="{{!dashboard.latest_exam && dashboard.profile_complete}}" bindtap="goToEntry">
    <view class="empty-title">先记录第一次成绩</view>
    <view class="empty-copy">录入最近一次周考、月考或模考成绩，就能看到孩子当前的升学范围。</view>
    <view class="empty-link">立即录入成绩 ›</view>
  </view>
  <view class="empty card empty-action" wx:if="{{!dashboard.profile_complete}}" bindtap="showProfile">
    <view class="empty-title">只需姓名、初中和年级</view>
    <view class="empty-copy">填写后即可开始记录成绩；目标高中可以以后再设置。</view>
    <view class="empty-link">建立孩子档案 ›</view>
  </view>

</view>

<view class="nav">
  <view class="nav-item active"><view>首页</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="goToScores"><view>成绩</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="showProfile"><view>我的</view><view class="nav-marker"></view></view>
</view>
</block>
