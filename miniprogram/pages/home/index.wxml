<block wx:if="{{loading}}"><view class="page"><view class="loading">正在整理孩子的升学信息</view></view></block>
<block wx:elif="{{loadError}}"><view class="page">
  <view class="error-title">暂时没有连接上</view><view class="error-copy">请检查网络后重新试一次。</view><button class="primary-button" bindtap="retry">重新加载</button>
</view></block>
<block wx:else><view class="page" wx:if="{{dashboard}}">
  <view class="topline">
    <view>
      <view class="eyebrow">NEXT PATH · 升学助手</view>
      <view class="greeting">{{dashboard.profile_complete ? dashboard.student_name + '的升学判断' : '先建立孩子档案'}}</view>
    </view>
    <button class="profile" bindtap="showProfile" aria-label="查看档案">档案</button>
  </view>

  <view class="forecast card" wx:if="{{dashboard.forecast}}">
    <view class="forecast-label">升学判断</view>
    <view class="target-block">
      <view class="target-label">目标</view>
      <view class="target-name" wx:if="{{dashboard.target_school}}">{{dashboard.target_school}}</view>
      <view class="target-name" wx:else>尚未设置目标高中</view>
      <view class="target-meta" wx:if="{{dashboard.forecast.target_comparison && dashboard.forecast.target_comparison.school_rank_range}}">近年参考边界：全区第 {{dashboard.forecast.target_comparison.school_rank_range[0]}}–{{dashboard.forecast.target_comparison.school_rank_range[1]}} 名</view>
      <view class="target-meta" wx:if="{{dashboard.forecast.target_comparison}}">{{dashboard.forecast.target_comparison.risk}}</view>
    </view>
    <view class="judgement-block" wx:if="{{dashboard.forecast.current_snapshot}}">
      <view class="judgement-label">当前现状</view>
      <view class="judgement-score">{{dashboard.forecast.current_snapshot.total_range[0]}}<text>/ {{dashboard.forecast.current_snapshot.total_full_mark}} 分</text></view>
      <view class="judgement-meta" wx:if="{{dashboard.forecast.current_snapshot.current_percentile !== null}}">当前位置：全区前 {{dashboard.forecast.current_snapshot.estimated_percentile_range[0]}}%–{{dashboard.forecast.current_snapshot.estimated_percentile_range[1]}}%</view>
      <view class="judgement-meta" wx:else>当前位置：暂未形成判断</view>
      <view class="gap-copy" wx:if="{{dashboard.forecast.target_comparison && dashboard.forecast.target_comparison.current_relation}}">与目标相比：{{dashboard.forecast.target_comparison.current_relation}}</view>
    </view>
    <view class="judgement-block projection" wx:if="{{dashboard.forecast.reasonable_projection}}">
      <view class="judgement-label">合理预测</view>
      <view class="judgement-score">{{dashboard.forecast.reasonable_projection.total_range[0]}}–{{dashboard.forecast.reasonable_projection.total_range[1]}}<text>/ {{dashboard.forecast.reasonable_projection.total_full_mark}} 分</text></view>
      <view class="judgement-meta" wx:if="{{dashboard.forecast.reasonable_projection.current_percentile !== null}}">预测位置：全区前 {{dashboard.forecast.reasonable_projection.estimated_percentile_range[0]}}%–{{dashboard.forecast.reasonable_projection.estimated_percentile_range[1]}}%</view>
      <view class="judgement-meta" wx:else>预测位置：暂未形成判断</view>
      <view class="gap-copy" wx:if="{{dashboard.forecast.target_comparison && dashboard.forecast.target_comparison.projected_relation}}">与目标相比：{{dashboard.forecast.target_comparison.projected_relation}}</view>
    </view>
    <button class="basis-link" bindtap="goToAnalysis">查看完整判断</button>
  </view>
  <view class="first-visit card" wx:else>
    <view class="first-title">{{dashboard.profile_complete ? '先建立第一份成绩判断' : '只需姓名、初中和年级'}}</view>
    <view class="muted">{{dashboard.profile_complete ? '录入最近一次周考、月考或模考成绩。系统会从这一条记录开始，持续更新孩子的位置和目标差距。' : '这些信息用于建立孩子所在初中与全区升学位置的关系，不要求填写无关资料。'}}</view>
  </view>

  <view class="latest card" wx:if="{{dashboard.latest_exam}}">
    <view>
      <view class="muted">最近一次 · {{dashboard.latest_exam.name}}</view>
      <view class="score-row"><text>{{dashboard.latest_exam.total_score}}</text><text>分</text></view>
    </view>
    <view class="rank" wx:if="{{dashboard.latest_exam.class_rank}}">班级第 {{dashboard.latest_exam.class_rank}} 名</view>
  </view>

  <button class="primary-button" bindtap="goToEntry">录入最新成绩</button>

  <view class="section-title">现在更值得做的事</view>
  <view class="action-list card">
    <view class="action" wx:for="{{dashboard.action_items}}" wx:key="title">
      <view class="action-dot {{item.priority}}"></view>
      <view><view class="action-title">{{item.title}}</view><view class="muted">{{item.detail}}</view></view>
    </view>
  </view>

  <view class="section-title">成绩变化</view>
  <view class="trend card">
    <view class="trend-item" wx:for="{{dashboard.trend}}" wx:key="name">
      <view class="muted">{{item.name}}</view><view class="trend-score">{{item.total_score}}</view>
    </view>
  </view>
</view>

<view class="nav">
  <view class="nav-item active"><view>首页</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="goToScores"><view>成绩</view><view class="nav-marker"></view></view>
  <view class="nav-item" bindtap="showProfile"><view>我的</view><view class="nav-marker"></view></view>
</view>
</block>
