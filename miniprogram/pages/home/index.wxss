/* ── Header ── */
.header { padding: 12rpx 0 32rpx; }
.greeting { margin-top: 8rpx; color: #1E293B; font-size: 44rpx; font-weight: 700; line-height: 1.25; }

/* ── Status Card ── */
.status-card {
  padding: 40rpx 32rpx;
  border: none;
  box-shadow: 0 4rpx 24rpx rgba(5, 150, 105, 0.08);
}
.status-scope {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: #ECFDF5;
  color: #059669;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 8rpx;
}
.status-score {
  margin-top: 28rpx;
  color: #1E293B;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -1rpx;
}
.status-fm {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #94A3B8;
  letter-spacing: 0;
}
.status-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 14rpx;
  margin-top: 20rpx;
  color: #64748B;
  font-size: 25rpx;
  line-height: 1.5;
}
.meta-sep { color: #CBD5E1; }
.status-rank {
  margin-top: 14rpx;
  color: #0EA5E9;
  font-size: 26rpx;
  font-weight: 500;
}

/* ── School Tiers ── */
.school-list {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F1F5F9;
}
.school-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 0;
  font-size: 25rpx;
  line-height: 1.5;
}
.tier-label {
  flex: none;
  width: 56rpx;
  color: #059669;
  font-weight: 600;
  font-size: 23rpx;
  padding-top: 2rpx;
}
.tier-schools {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 18rpx;
}
.school-name {
  color: #475569;
}

/* ── Summary Card ── */
.summary-card {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
}
.summary-label {
  color: #64748B;
  font-size: 24rpx;
  font-weight: 500;
}
.summary-value {
  margin-top: 8rpx;
  color: #1E293B;
  font-size: 32rpx;
  font-weight: 700;
}
.summary-hint {
  margin-top: 6rpx;
  color: #475569;
  font-size: 25rpx;
}
.summary-link {
  margin-top: 8rpx;
  color: #0EA5E9;
  font-size: 26rpx;
  font-weight: 500;
}

/* ── Collapsible Sections ── */
.section { margin-top: 28rpx; }
.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  cursor: pointer;
}
.section-label {
  color: #1E293B;
  font-size: 30rpx;
  font-weight: 700;
}
.section-toggle {
  color: #0EA5E9;
  font-size: 24rpx;
  font-weight: 500;
}

/* ── Actions ── */
.actions {
  margin-top: 48rpx;
  padding: 0 0 8rpx;
}
.action-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 20rpx;
  padding-bottom: 8rpx;
}
.action-link {
  color: #0EA5E9;
  font-size: 26rpx;
  font-weight: 500;
}

/* ── Latest Exam ── */
.latest-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}
.latest-info { flex: 1; min-width: 0; }
.latest-name {
  color: #1E293B;
  font-size: 29rpx;
  font-weight: 650;
}
.latest-date {
  margin-top: 6rpx;
  color: #64748B;
  font-size: 24rpx;
}
.latest-score {
  flex: none;
  text-align: right;
  padding: 0 16rpx;
}
.score-num {
  color: #1E293B;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 48rpx;
  font-weight: 700;
}
.score-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

/* ── Trend ── */
.trend-card {
  display: flex;
  align-items: stretch;
  padding: 24rpx 0;
}
.trend-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  border-left: 1rpx solid #F1F5F9;
}
.trend-item:first-child { border-left: none; }
.trend-name { color: #64748B; font-size: 23rpx; }
.trend-score {
  margin-top: 10rpx;
  color: #1E293B;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 36rpx;
  font-weight: 700;
}

/* ── Empty States ── */
.empty {
  margin-bottom: 24rpx;
  padding: 36rpx 28rpx;
  background: #F8FAFC;
  border-color: #E2E8F0;
}
.empty-title {
  margin-bottom: 8rpx;
  color: #1E293B;
  font-size: 32rpx;
  font-weight: 700;
}
.empty-copy {
  color: #64748B;
  font-size: 26rpx;
  line-height: 1.7;
}

/* ── Error State ── */
.error-title {
  margin-top: 200rpx;
  color: #1E293B;
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
}
.error-copy {
  margin: 16rpx 0 40rpx;
  color: #64748B;
  font-size: 27rpx;
  text-align: center;
}
.error-copy + .primary-button { width: 100%; }
