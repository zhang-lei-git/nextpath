.topline { display:flex; justify-content:space-between; align-items:flex-start; margin:20rpx 0 36rpx; }
.greeting { margin-top:10rpx; color:#143F43; font-size:42rpx; font-weight:700; }
.profile { padding:12rpx 0 12rpx 20rpx; color:#2C6194; font-size:26rpx; }
.forecast { padding:32rpx; background:#143F43; border:0; color:#FFFFFF; }
.forecast-label, .scenario-label, .target-label { color:#B9D9D2; font-size:23rpx; }
.target-row { display:flex; width:100%; align-items:center; justify-content:space-between; padding:20rpx 0 24rpx; color:#FFFFFF; text-align:left; }
.target-name { margin-top:6rpx; color:#FFFFFF; font-size:36rpx; font-weight:700; line-height:1.35; }
.row-arrow { flex:none; color:#9DCAC0; font-size:38rpx; line-height:1; }
.scenario { padding:26rpx 0; border-top:1rpx solid rgba(255,255,255,.2); }
.scenario.projection { border-top-color:rgba(137,205,188,.55); }
.scope-title { margin:7rpx 0 10rpx; color:#FFFFFF; font-size:34rpx; font-weight:700; line-height:1.35; }
.scenario-score { color:#FFFFFF; font-family:ui-monospace, Menlo, monospace; font-size:44rpx; font-weight:700; }
.scenario-score text { margin-left:6rpx; color:#D8E9E5; font-family:inherit; font-size:23rpx; font-weight:500; }
.scenario-rank { margin-top:8rpx; color:#D8E9E5; font-size:24rpx; line-height:1.5; }
.school-list { margin-top:20rpx; padding:16rpx 18rpx; background:rgba(255,255,255,.08); border-radius:8rpx; }
.school-row { display:flex; gap:14rpx; padding:7rpx 0; color:#E7F2EF; font-size:23rpx; line-height:1.45; }
.school-row text { width:50rpx; flex:none; color:#A9D8CD; }
.target-gap { margin-top:2rpx; padding:20rpx 0; border-top:1rpx solid rgba(255,255,255,.2); color:#D8E9E5; font-size:23rpx; line-height:1.7; }
.target-gap-title { margin-bottom:4rpx; color:#FFFFFF; font-size:27rpx; font-weight:600; }
.target-setup { display:flex; width:100%; justify-content:space-between; margin-top:2rpx; padding:22rpx 0; border-top:1rpx solid rgba(255,255,255,.2); color:#FFFFFF; font-size:25rpx; text-align:left; }
.target-setup text { color:#B9D9D2; font-size:22rpx; }
.basis-link { margin-top:4rpx; padding:14rpx 0 2rpx; color:#FFFFFF; font-size:26rpx; text-align:left; }
.first-visit { margin-bottom:24rpx; padding:32rpx; background:#EFF6F4; border-color:#CFE0DB; }
.first-title { margin-bottom:10rpx; color:#143F43; font-size:34rpx; font-weight:700; }
.latest { display:flex; align-items:center; justify-content:space-between; margin:0 0 24rpx; padding:24rpx 28rpx; }
.latest-name { margin-bottom:7rpx; color:#143F43; font-size:29rpx; font-weight:650; }
.latest-side { text-align:right; }
.score-row { color:#143F43; font-family:ui-monospace, Menlo, monospace; font-size:44rpx; font-weight:700; }
.score-row text:last-child { margin-left:5rpx; font-family:inherit; font-size:22rpx; font-weight:500; }
.row-link, .trend-link, .report-link { margin-top:6rpx; color:#2C6194; font-size:22rpx; }
.action-list { padding:6rpx 28rpx; }
.action { display:flex; align-items:flex-start; gap:18rpx; padding:25rpx 0; border-bottom:1rpx solid #E2E8E5; }
.action:last-child { border-bottom:0; }
.action .row-arrow { margin-left:auto; margin-top:8rpx; color:#2C6194; }
.action-dot { width:12rpx; height:12rpx; flex:none; margin-top:13rpx; border-radius:50%; background:#16766D; }
.action-dot.high { background:#9A6614; }
.action-title { margin-bottom:5rpx; color:#143F43; font-size:29rpx; font-weight:600; }
.trend { display:flex; align-items:stretch; padding:26rpx 22rpx; }
.trend-item { flex:1; min-width:0; border-left:1rpx solid #E2E8E5; text-align:center; }
.trend-item:first-child { border-left:0; }
.trend-score { margin-top:10rpx; color:#143F43; font-family:ui-monospace, Menlo, monospace; font-size:36rpx; font-weight:700; }
.trend-link { display:flex; align-items:center; padding-left:15rpx; white-space:nowrap; }
.report-link { display:block; width:100%; padding:18rpx 0 12rpx; text-align:left; }
.loading, .error-title { margin-top:180rpx; color:#143F43; font-size:38rpx; font-weight:700; text-align:center; }
.error-copy { margin:18rpx 0 44rpx; color:#687574; font-size:27rpx; text-align:center; }
.error-copy + .primary-button { width:100%; }
