.topline { display: flex; justify-content: space-between; align-items: flex-start; margin: 20rpx 0 36rpx; }
.greeting { margin-top: 10rpx; color: #143F43; font-size: 42rpx; font-weight: 700; }
.profile { padding: 12rpx 0 12rpx 20rpx; color: #2C6194; font-size: 26rpx; }
.quiet-note { margin-bottom: 20rpx; padding: 16rpx 20rpx; color: #725017; background: #FFF7E9; border-radius: 12rpx; font-size: 24rpx; }
.forecast { padding: 32rpx; background: #143F43; border: 0; color: #FFFFFF; }
.first-visit { margin-bottom: 24rpx; padding: 32rpx; background: #EFF6F4; border-color: #CFE0DB; }
.first-title { margin-bottom: 10rpx; color: #143F43; font-size: 34rpx; font-weight: 700; }
.forecast-label { color: #B9D9D2; font-size: 24rpx; }
.forecast-tier { margin: 12rpx 0; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.forecast-meta { color: #D8E9E5; font-size: 25rpx; }
.forecast-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 36rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(255,255,255,.2); }
.gap-number { font-family: ui-monospace, Menlo, monospace; font-size: 56rpx; font-weight: 700; }
.gap-unit { margin-left: 4rpx; font-size: 26rpx; }
.gap-copy { margin-top: 5rpx; color: #B9D9D2; font-size: 22rpx; }
.basis-link { padding: 10rpx 0 10rpx 18rpx; color: #FFFFFF; font-size: 26rpx; }
.latest { display: flex; align-items: center; justify-content: space-between; margin: 20rpx 0 24rpx; padding: 24rpx 28rpx; }
.score-row { margin-top: 8rpx; color: #143F43; font-family: ui-monospace, Menlo, monospace; font-size: 52rpx; font-weight: 700; }
.score-row text:last-child { margin-left: 6rpx; font-family: inherit; font-size: 25rpx; font-weight: 500; }
.rank { padding: 12rpx 16rpx; color: #2C6194; background: #EFF5FA; border-radius: 10rpx; font-size: 24rpx; }
.action-list { padding: 6rpx 28rpx; }
.action { display: flex; gap: 18rpx; padding: 25rpx 0; border-bottom: 1rpx solid #E2E8E5; }
.action:last-child { border-bottom: 0; }
.action-dot { width: 12rpx; height: 12rpx; flex: none; margin-top: 13rpx; border-radius: 50%; background: #16766D; }
.action-dot.high { background: #9A6614; }
.action-title { margin-bottom: 5rpx; color: #143F43; font-size: 29rpx; font-weight: 600; }
.trend { display: flex; padding: 26rpx 28rpx; }
.trend-item { flex: 1; border-left: 1rpx solid #E2E8E5; text-align: center; }
.trend-item:first-child { border-left: 0; }
.trend-score { margin-top: 10rpx; color: #143F43; font-family: ui-monospace, Menlo, monospace; font-size: 38rpx; font-weight: 700; }
.source-note { margin: 20rpx 4rpx; color: #687574; font-size: 21rpx; line-height: 1.65; }
.loading,.error-title { margin-top:180rpx; color:#143F43; font-size:38rpx; font-weight:700; text-align:center; }.error-copy { margin:18rpx 0 44rpx; color:#687574; font-size:27rpx; text-align:center; }.error-copy + .primary-button { width:100%; }
