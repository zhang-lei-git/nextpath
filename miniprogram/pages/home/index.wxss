/* ── Header ── */
.header { padding: 12rpx 0 32rpx; }
.greeting { margin-top: 8rpx; color: #1E293B; font-size: 44rpx; font-weight: 700; line-height: 1.25; }
.home-decisions { display:flex; flex-direction:column; gap:20rpx; }
.decision-card { overflow:hidden; border:1rpx solid #DCE7E4; box-shadow:0 8rpx 28rpx rgba(15, 80, 70, .06); }
.current-card { border-top:8rpx solid #059669; }
.projection-card { border-top:8rpx solid #0EA5E9; background:#F6FBFF; }
.decision-label { margin-top:8rpx; color:#64748B; font-size:23rpx; }
.decision-block { padding:32rpx 30rpx; }
.decision-kicker { color:#64748B; font-size:24rpx; font-weight:600; }
.decision-answer { margin-top:12rpx; color:#153F3D; font-size:38rpx; font-weight:750; line-height:1.35; }
.decision-rank { margin-top:8rpx; color:#0F766E; font-size:28rpx; font-weight:650; }
.decision-score { margin-top:18rpx; color:#334155; font-size:27rpx; }
.decision-grade { margin-top:8rpx; color:#64748B; font-size:24rpx; }
.school-heading { margin-top:22rpx; color:#475569; font-size:24rpx; font-weight:650; }
.school-chips { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:12rpx; }
.school-groups { display:flex; flex-direction:column; gap:10rpx; margin-top:10rpx; }
.school-group { display:flex; align-items:flex-start; gap:10rpx; }
.group-label { flex:none; min-width:100rpx; padding-top:10rpx; color:#64748B; font-size:22rpx; }
.school-basis-note { margin-top:14rpx; color:#94A3B8; font-size:21rpx; line-height:1.5; }
.school-chip { padding:12rpx 18rpx; border-radius:999rpx; background:#EFF8F5; color:#176B53; font-size:24rpx; font-weight:600; }
.uncertain { margin-top:16rpx; color:#64748B; font-size:24rpx; line-height:1.55; }
.decision-divider { height:1rpx; margin:0 30rpx; background:#E2E8F0; }
.target-line { display:flex; justify-content:space-between; gap:16rpx; padding:22rpx 30rpx; border-top:1rpx solid #E2E8F0; color:#1E293B; font-size:25rpx; }
.target-card { border:1rpx solid #F0C36B; border-top:8rpx solid #D97706; background:#FFFBEB; }
.target-block { padding:28rpx 30rpx; }
.target-kicker { color:#64748B; font-size:24rpx; }
.target-name { margin-top:8rpx; color:#1E293B; font-size:34rpx; font-weight:750; }
.target-relation { margin-top:12rpx; color:#0F766E; font-size:27rpx; font-weight:650; }
.target-gap { margin-top:8rpx; color:#475569; font-size:25rpx; }
.target-more { margin-top:16rpx; color:#0EA5E9; font-size:25rpx; }
.target-button { height:76rpx; margin-top:20rpx; border:1rpx solid #D97706; border-radius:12rpx; color:#B45309; background:#FFF7E0; font-size:27rpx; line-height:76rpx; text-align:center; }
.analysis-button { height:88rpx; margin-top:4rpx; border:1rpx solid #CBD5E1; border-radius:14rpx; color:#0F766E; background:#FFFFFF; font-size:28rpx; line-height:88rpx; text-align:center; }
.target-line text:last-child { color:#0EA5E9; text-align:right; }
.target-empty { color:#64748B; }
.analysis-link { padding:0 30rpx 26rpx; color:#0EA5E9; font-size:25rpx; }

/* ── Status Card ── */
.status-card {
  padding: 40rpx 32rpx;
  border: none;
  box-shadow: 0 4rpx 24rpx rgba(5, 150, 105, 0.08);
}
.status-scope {
  display: inline-block;
  padding: 6rpx 20rpx;
  background: #ECFDF5;
  color: #059669;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 8rpx;
}
.status-score {
  margin-top: 28rpx;
  color: #1E293B;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -1rpx;
}
.status-fm {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  color: #94A3B8;
  letter-spacing: 0;
}
.status-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 14rpx;
  margin-top: 20rpx;
  color: #64748B;
  font-size: 25rpx;
  line-height: 1.5;
}
.meta-sep { color: #CBD5E1; }
.status-rank {
  margin-top: 14rpx;
  color: #0EA5E9;
  font-size: 26rpx;
  font-weight: 500;
}

/* ── School Tiers ── */
.school-list {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F1F5F9;
}
.school-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 0;
  font-size: 25rpx;
  line-height: 1.5;
}
.tier-label {
  flex: none;
  width: 56rpx;
  color: #059669;
  font-weight: 600;
  font-size: 23rpx;
  padding-top: 2rpx;
}
.tier-schools {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 18rpx;
}
.school-name {
  color: #475569;
}

/* ── Summary Card ── */
.summary-card {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
}
.summary-label {
  color: #64748B;
  font-size: 24rpx;
  font-weight: 500;
}
.summary-value {
  margin-top: 8rpx;
  color: #1E293B;
  font-size: 32rpx;
  font-weight: 700;
}
.summary-hint {
  margin-top: 6rpx;
  color: #475569;
  font-size: 25rpx;
}
.summary-link {
  margin-top: 8rpx;
  color: #0EA5E9;
  font-size: 26rpx;
  font-weight: 500;
}
.change-card { margin-top: 28rpx; padding: 28rpx 32rpx; }
.change-grid { display: flex; gap: 20rpx; margin-top: 18rpx; }
.change-grid view { flex: 1; min-width: 0; }
.change-grid text { display: block; color: #64748B; font-size: 23rpx; }
.change-grid strong { display: block; margin-top: 8rpx; color: #1E293B; font-size: 27rpx; }
.change-note { margin-top: 18rpx; color: #64748B; font-size: 25rpx; }
.forecast-section { margin-top: 32rpx; }
.forecast-card { margin-top: 16rpx; padding: 28rpx 32rpx; }
.forecast-card.steady { border-color:#059669; background:#ECFDF5; }
.forecast-head { display:flex; justify-content:space-between; gap:16rpx; color:#1E293B; font-size:27rpx; font-weight:650; }
.forecast-head text:last-child { color:#059669; text-align:right; }
.forecast-score { margin-top:18rpx; color:#1E293B; font-family:ui-monospace,Menlo,monospace; font-size:40rpx; font-weight:700; }
.forecast-score text { margin-left:6rpx; color:#64748B; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:23rpx; font-weight:400; }
.forecast-rank { margin-top:10rpx; color:#64748B; font-size:25rpx; }
.forecast-link { margin-top:18rpx; color:#0EA5E9; font-size:25rpx; }

/* ── Collapsible Sections ── */
.section { margin-top: 28rpx; }
.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  cursor: pointer;
}
.section-label {
  color: #1E293B;
  font-size: 30rpx;
  font-weight: 700;
}
.section-toggle {
  color: #0EA5E9;
  font-size: 24rpx;
  font-weight: 500;
}

/* ── Actions ── */
.actions {
  margin-top: 48rpx;
  padding: 0 0 8rpx;
}
.action-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 20rpx;
  padding-bottom: 8rpx;
}
.action-link {
  color: #0EA5E9;
  font-size: 26rpx;
  font-weight: 500;
}

/* ── Latest Exam ── */
.latest-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}
.latest-info { flex: 1; min-width: 0; }
.latest-name {
  color: #1E293B;
  font-size: 29rpx;
  font-weight: 650;
}
.latest-date {
  margin-top: 6rpx;
  color: #64748B;
  font-size: 24rpx;
}
.latest-score {
  flex: none;
  text-align: right;
  padding: 0 16rpx;
}
.score-num {
  color: #1E293B;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 48rpx;
  font-weight: 700;
}
.score-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  color: #94A3B8;
}

/* ── Trend ── */
.trend-card {
  display: flex;
  align-items: stretch;
  padding: 24rpx 0;
}
.trend-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  border-left: 1rpx solid #F1F5F9;
}
.trend-item:first-child { border-left: none; }
.trend-name { color: #64748B; font-size: 23rpx; }
.trend-score {
  margin-top: 10rpx;
  color: #1E293B;
  font-family: ui-monospace, Menlo, monospace;
  font-size: 36rpx;
  font-weight: 700;
}

/* ── Empty States ── */
.empty {
  margin-bottom: 24rpx;
  padding: 36rpx 28rpx;
  background: #F8FAFC;
  border-color: #E2E8F0;
}
.empty-action { cursor: pointer; }
.empty-link { margin-top: 20rpx; color: #0EA5E9; font-size: 27rpx; font-weight: 600; }
.empty-title {
  margin-bottom: 8rpx;
  color: #1E293B;
  font-size: 32rpx;
  font-weight: 700;
}
.empty-copy {
  color: #64748B;
  font-size: 26rpx;
  line-height: 1.7;
}

/* ── Error State ── */
.error-title {
  margin-top: 200rpx;
  color: #1E293B;
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
}
.error-copy {
  margin: 16rpx 0 40rpx;
  color: #64748B;
  font-size: 27rpx;
  text-align: center;
}
.error-copy + .primary-button { width: 100%; }
