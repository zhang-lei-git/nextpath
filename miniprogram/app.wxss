page {
  min-height: 100%;
  background: #F8FAFC;
  color: #334155;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ── Reset ── */
button {
  display: block;
  width: 100%;
  margin: 0; padding: 0; border: 0;
  background: transparent;
  line-height: inherit;
  text-align: inherit;
}
button::after { border: none; }

/* ── Page shell ── */
.page { padding: 28rpx 32rpx 280rpx; }

/* ── Typography ── */
.eyebrow { color: #059669; font-size: 24rpx; font-weight: 700; letter-spacing: 1rpx; }

.page-title {
  margin: 12rpx 0 28rpx;
  color: #1E293B;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.intro {
  margin-bottom: 28rpx;
  color: #64748B;
  font-size: 27rpx;
  line-height: 1.7;
}

.section-title { margin: 36rpx 0 20rpx; color: #1E293B; font-size: 34rpx; font-weight: 700; line-height: 1.35; }

/* ── Cards ── */
.card { background: #FFFFFF; border: 1rpx solid #E2E8F0; border-radius: 16rpx; }

.muted { color: #94A3B8; font-size: 24rpx; line-height: 1.6; }

/* ── Buttons ── */
.primary-button {
  height: 96rpx;
  margin-top: 28rpx;
  border-radius: 16rpx;
  background: #059669;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  text-align: center;
}
.secondary-button {
  height: 88rpx;
  margin-top: 16rpx;
  border: 1rpx solid #CBD5E1;
  border-radius: 14rpx;
  color: #1E293B;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
}

/* ── Section rhythm ── */
.section + .section { margin-top: 28rpx; }

/* ── Bottom navigation ── */
.nav {
  position: fixed;
  z-index: 10;
  bottom: 0; left: 0; right: 0;
  display: flex;
  height: 116rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255,255,255,.98);
  border-top: 1rpx solid #E2E8F0;
}
.nav-item { flex: 1; padding-top: 18rpx; color: #94A3B8; font-size: 24rpx; text-align: center; }
.nav-item.active { color: #059669; font-weight: 700; }
.nav-marker { width: 36rpx; height: 6rpx; margin: 10rpx auto 0; background: transparent; border-radius: 99rpx; }
.nav-item.active .nav-marker { background: #059669; }

/* ── Loading ── */
.loading {
  padding-top: 360rpx;
  color: #64748B;
  font-size: 30rpx;
  text-align: center;
}
